# Bolsa de Empleo UD — variables de entorno
# Copia a .env y completa. No subas .env a git.

# Despliegue (docker-compose): dominio público. Sin dominio propio puedes usar
# la IP pública con sslip.io, p. ej. 129-146-10-20.sslip.io
DOMAIN=rutaud.example.com

# App
APP_NAME=Bolsa de Empleo UD
APP_ENV=development
API_PREFIX=/api/v1

# Tenant MVP
DEFAULT_TENANT_SLUG=universidad-distrital
DEFAULT_CITY=Bogotá
DEFAULT_PROGRAM_SLUG=ingenieria-de-sistemas
MAX_OFFER_AGE_HOURS=24

# DeepSeek — https://platform.deepseek.com
# El MODELO está fijo en código: deepseek-v4-flash (el más barato).
# DEEPSEEK_MODEL en .env se IGNORA a propósito: producción no puede
# pasarse a v4-pro por un error de deploy.
DEEPSEEK_API_KEY=sk-tu_clave_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Cuotas IA (por estudiante / mes)
CV_GENERATIONS_PER_STUDENT_MONTH=10
# Topes diarios de llamadas a DeepSeek (al superarlos se usa el adaptador local sin IA).
# 200/día ≈ máx. $0.30/día en horario pico con deepseek-v4-flash.
DEEPSEEK_DAILY_LIMIT=200
DEEPSEEK_DAILY_LIMIT_PER_IP=30

# Proxy de respaldo para scrapers: si un portal bloquea la IP del servidor, la búsqueda
# se repite por aquí. Vacío = sin proxy. Formato: http://usuario:clave@host:puerto
# Ver docs/deploy/oracle-cloud.md (opción gratis: tu PC vía Tailscale).
SCRAPER_PROXY_URL=

# Base de datos (MVP puede usar SQLite; producción Postgres)
DATABASE_URL=sqlite:///./data/bolsa_empleo.db
